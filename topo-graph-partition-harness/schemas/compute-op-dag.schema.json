{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wolvrix Compute Op DAG",
  "type": "object",
  "required": ["format", "graph_id", "options", "nodes", "edges"],
  "properties": {
    "format": { "const": "wolvrix.compute-op-dag.v1" },
    "graph_id": { "type": "string" },
    "source": { "type": "object" },
    "options": {
      "type": "object",
      "required": ["node_granularity", "edge_weight"],
      "not": { "required": ["node_weight"] },
      "properties": {
        "node_granularity": { "const": "op" },
        "edge_weight": { "const": "value_bitwidth_words" }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "nodes": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "edge_weight_total": { "type": "integer", "minimum": 0 }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "op_id", "topo_pos"],
        "not": { "required": ["weight"] },
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "op_id": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string" },
          "symbol": { "type": "string" },
          "topo_pos": { "type": "integer", "minimum": 0 },
          "attrs": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "dst", "weight", "values"],
        "properties": {
          "src": { "type": "integer", "minimum": 0 },
          "dst": { "type": "integer", "minimum": 0 },
          "weight": { "type": "integer", "minimum": 1 },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "width"],
              "not": {
                "anyOf": [
                  { "required": ["weight"] },
                  { "required": ["activation_weight"] },
                  { "required": ["propagation_weight"] }
                ]
              },
              "properties": {
                "id": { "type": "integer", "minimum": 0 },
                "width": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
