{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wolvrix Compute Op DAG",
  "type": "object",
  "required": ["format", "graph_id", "nodes", "edges"],
  "properties": {
    "format": { "const": "wolvrix.compute-op-dag.v1" },
    "graph_id": { "type": "string" },
    "source": { "type": "object" },
    "options": { "type": "object" },
    "stats": {
      "type": "object",
      "properties": {
        "nodes": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "node_weight_total": { "type": "integer", "minimum": 0 },
        "max_node_weight": { "type": "integer", "minimum": 0 },
        "edge_weight_total": { "type": "integer", "minimum": 0 }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "op_id", "weight", "topo_pos"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "op_id": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string" },
          "symbol": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1 },
          "topo_pos": { "type": "integer", "minimum": 0 },
          "attrs": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "dst", "weight"],
        "properties": {
          "src": { "type": "integer", "minimum": 0 },
          "dst": { "type": "integer", "minimum": 0 },
          "weight": { "type": "integer", "minimum": 1 },
          "values": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
