{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wolvrix Compute Op Partition",
  "type": "object",
  "required": ["format", "graph_id", "algorithm", "constraints", "assignment"],
  "properties": {
    "format": { "const": "wolvrix.compute-op-partition.v1" },
    "graph_id": { "type": "string" },
    "algorithm": { "type": "object" },
    "constraints": {
      "type": "object",
      "required": ["max_nodes_per_part"],
      "properties": {
        "max_nodes_per_part": { "type": "integer", "minimum": 0 }
      }
    },
    "assignment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "part"],
        "properties": {
          "node": { "type": "integer", "minimum": 0 },
          "part": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "part_order_hint": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "stats_hint": { "type": "object" }
  }
}
